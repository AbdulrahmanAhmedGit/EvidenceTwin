    {
      "name": "Question composer",
      "kind": "custom",
      "refersTo": "composer",
      "description": "Compact question composer with actual attachment thumbnails above the question and anchored top-layer popovers. Runtime auto-sizes from 56px to min(340px, 40vh), or min(340px, 30vh) below 600px. Explicit expansion uses 65vh. CSV thumbnails show first complete records from a bounded local read.",
      "html": "<div class=\"ds-composer\"><textarea class=\"ds-question\" aria-label=\"Scientific question\" placeholder=\"Ask a research question…\"></textarea><div class=\"ds-composer-footer\"><div class=\"ds-tools\"><button aria-label=\"Add supporting information\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg></button><button>Visual review</button></div><button class=\"ds-create\">Create investigation</button></div></div>",
      "css": ".ds-composer{border:1px solid var(--color-border-control,#8793a6);border-radius:12px;background:var(--paper,#fff);color:var(--ink,#202737)}.ds-composer:focus-within{border-color:var(--accent,#3159bb)}.ds-question{box-sizing:border-box;width:100%;min-height:56px;max-height:min(340px,40vh);resize:none;border:0;background:transparent;color:inherit;padding:14px 18px 8px;font:400 1.0625rem/1.75 var(--font-body,Manrope,sans-serif);unicode-bidi:plaintext}.ds-composer-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:6px 12px 12px;font:.8125rem var(--font-body,Manrope,sans-serif)}.ds-tools{display:flex;align-items:center;gap:4px}.ds-tools button{font:500 .8125rem var(--font-body,Manrope,sans-serif);border:0;border-radius:7px;padding:8px 10px;min-height:40px;background:transparent;color:inherit}.ds-tools button:hover{background:var(--surface,#f1f3f6)}.ds-create{background:var(--accent,#3159bb);color:var(--on-accent,#fff);border:0;border-radius:7px;padding:9px 12px;min-height:40px;font:600 .8125rem var(--font-body,Manrope,sans-serif)}.ds-create:hover{background:var(--accent-hover,#244596)}.ds-composer :focus-visible{outline:2px solid var(--accent,#3159bb);outline-offset:3px}@media(max-width:599px){.ds-question{max-height:min(340px,30vh)}}"
