  "narrative": {
    "northStar": "The annotated seminar review",
    "overview": "Neutral paper and charcoal surfaces, restrained cobalt actions and readable contributions give research a calm working environment. Questions, supplied evidence and individual interpretations stay distinct. Interface language supports English and Arabic while research retains its supplied wording and direction.\n\nThis system records the authorized application reconstruction and its unified results and report extension through 2026-11-08. Runtime authority is `frontend/src/styles/{precision,workspace,observatory}.css`, `features/analyses/research-entry.css`, and the inspection, evidence findings, results overview and report reader styles under `frontend/src/features/inspection/`. Public showcase composition remains separate. Scientific validation and hosted-pilot readiness require their own evidence.",
    "keyCharacteristics": [
      "Bounded headings and generous scientific reading measures.",
      "Paper reading surfaces, contextual controls and disclosed detail.",
      "Semantic light/dark themes and logical RTL layout."
    ],
    "rules": [
      {
        "name": "The Semantic Surface Rule",
        "body": "Resolve surfaces, text and controls through the active theme's semantic variables.",
        "section": "colors"
      },
      {
        "name": "The Source Wording Rule",
        "body": "Compact display titles use a bounded verbatim excerpt. Results and reports prefer a quoted claim or remove a recognized English or Arabic instruction wrapper before truncation. Full scientific wording remains available in the original-question disclosure and preserved report records.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do resolve surfaces, text, controls and status through semantic CSS variables.",
      "Do preserve question, evidence revision and real review history as distinct records.",
      "Do use Manrope/Alan Sans for prose and IBM Plex Mono for code and numerical data.",
      "Do preserve original content direction with dir=\"auto\", bdi and isolated code.",
      "Do keep visible focus, reduced motion and honest missing/failed/unavailable states.",
      "Do preserve official logo bytes, colors, proportions and orientation."
    ],
    "donts": [
      "Don't treat AI agreement, parsing or a completed run as scientific proof.",
      "Don't recolor or mirror the official artwork.",
      "Don't add decorative gradients or fabricated findings.",
      "Don't present a URL as retrieved, a PDF as extracted or XLSX as supported."
    ]
  }
